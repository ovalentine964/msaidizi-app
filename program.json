{
  "identity": {
    "name": "Msaidizi",
    "role": "Voice-first AI CFO for informal workers",
    "language_primary": "Swahili",
    "language_secondary": "English",
    "target": "Kenya's 17.5M informal workers",
    "personality": "Warm, friendly, like a trusted business partner",
    "response_style": "1-3 sentences for simple queries"
  },
  "architecture": {
    "pattern": "unified_brain",
    "pipeline": ["intent_router", "context_assembly", "capability_activation", "guardrails", "response"],
    "execution_loop": "OODA",
    "llm": "Qwen 0.8B on-device",
    "prompt_format": "Hermes function calling"
  },
  "intent_router": {
    "tiers": {
      "tier1": { "strategy": "pattern_match", "coverage": 0.60, "cost": "zero", "confidence_threshold": 0.8 },
      "tier2": { "strategy": "embedding_similarity", "coverage": 0.25, "cost": "zero", "similarity_threshold": 0.75, "escalation_threshold": 0.50, "embedding_dim": 256 },
      "tier3": { "strategy": "llm_function_calling", "coverage": 0.15, "max_tokens": 128 }
    },
    "intent_types": {
      "mutating": ["RECORD_SALE", "RECORD_EXPENSE", "RECORD_PURCHASE", "RECORD_SERVICE", "RECORD_PAYMENT", "ADD_PRODUCT", "UPDATE_STOCK", "QUICK_SALE"],
      "read_only": ["ASK_SALES_TODAY", "ASK_PROFIT", "ASK_EXPENSES", "ASK_STOCK", "ASK_DEBTORS", "CHECK_CUSTOMER_DEBT"],
      "extended": ["SCAN_RECEIPT", "VIEW_DASHBOARD", "CHAMA_MANAGE", "CREDIT_CHECK", "LOAN_COMPARE", "INSURANCE_MATCH", "RIDE_SHARE", "MARKET_PRICE", "PROOF_OF_INCOME", "GOAL_TRACK", "WHATSAPP_REPORT"],
      "conversational": ["GREETING", "FAREWELL", "THANKS", "HELP", "CHITCHAT"],
      "system": ["UNKNOWN", "VOICE_COMMAND"]
    }
  },
  "ooda_loop": {
    "max_iterations": 3,
    "confidence_threshold": 0.85,
    "convergence_threshold": 0.05,
    "latency_budget_ms": 30000,
    "simple_operations_single_pass": ["GREETING", "FAREWELL", "THANKS", "HELP", "CHITCHAT", "ASK_SALES_TODAY", "ASK_EXPENSES", "ASK_STOCK", "CHECK_STOCK"]
  },
  "memory": {
    "layers": {
      "L1_working": { "storage": "RAM", "scope": "session", "max_entries": 1000, "rolling_window": 10 },
      "L2_conversation": { "storage": "SQLite", "scope": "cross_session", "max_entries": 1000 },
      "L3_daily": { "storage": "SQLite", "scope": "per_day", "max_entries": 1000 },
      "L4_patterns": { "storage": "SQLite", "scope": "weekly_monthly", "max_entries": 1000 }
    },
    "recent_conversation_limit": 20,
    "prune_age_days": 30,
    "search": "inverted_index"
  },
  "guardrails": {
    "financial_integrity": {
      "layers": 7,
      "source_max_age_hours": 24,
      "duplicate_window_minutes": 5,
      "amount_bounds_ksh": {
        "SALE": { "min": 1, "max": 500000 },
        "EXPENSE": { "min": 1, "max": 200000 },
        "PURCHASE": { "min": 1, "max": 1000000 },
        "SERVICE": { "min": 10, "max": 100000 },
        "REPORT": { "min": 0, "max": 10000000 }
      },
      "max_transaction_ksh": 1000000,
      "valid_payment_methods": ["cash", "mpesa", "credit", "bank", "card"]
    },
    "hallucination_detection": {
      "stages": 5,
      "confidence_labels": {
        "GREEN": { "threshold": 0.8, "action": "allow" },
        "YELLOW": { "threshold": 0.5, "action": "warn" },
        "RED": { "threshold": 0.0, "action": "block" }
      }
    },
    "blocked_patterns": ["your bank account", "transfer money", "send to", "loan application"],
    "escalation_levels": ["LOW", "MODERATE", "HIGH", "CRITICAL"]
  },
  "metrics": {
    "primary": "user_retention_daily_active",
    "secondary": "transaction_recording_accuracy",
    "tertiary": "advice_quality_score"
  },
  "experiment_budget": {
    "max_per_day": 3,
    "max_tokens_per_experiment": 128
  },
  "run_commands": {
    "build": "./gradlew assembleDebug",
    "test": "./gradlew test",
    "lint": "./gradlew lint"
  },
  "output_parsing": {
    "success": "response with confidence label (GREEN/YELLOW)",
    "failure": "Pole sana, something went wrong. Please try again.",
    "blocked": "Samahani, I can't do that.",
    "approval_pending": "Unakubali? (Do you approve?)",
    "crash": "HarnessResponse(error = exception.message)"
  },
  "commit_revert": {
    "keep": "metric improves",
    "revert": "metric degrades or crash"
  },
  "human_escalation": {
    "triggers": [
      "OODA confidence < 0.3",
      "CRITICAL escalation level",
      "hallucination RED label",
      "transaction > 1,000,000 Ksh",
      "user complaint detected"
    ],
    "method": "EscalationManager → advisory in response"
  },
  "exhaustion_criteria": [
    "OODA confidence >= 0.85",
    "3 iterations completed",
    "improvement < 0.05 between iterations",
    "latency > 21000ms",
    "guardrails block output"
  ],
  "entity_extraction": {
    "currency": "ksh|kes|shillings?\\s*(\\d+)",
    "phone": "(?:\\+?254|0)[17]\\d{8}",
    "number": "\\d+\\.?\\d*"
  }
}
