# ── Build ─────────────────────────────────────────────────────
*.iml
.gradle/
/local.properties
/.idea/
build/
/captures
.externalNativeBuild/
.cxx/

# ── Signing ───────────────────────────────────────────────────
keystore.properties
*.jks
*.keystore

# ── Model Assets (too large for git) ─────────────────────────
app/src/main/assets/models/gguf/*.gguf
app/src/main/assets/models/onnx-whisper/*.onnx
app/src/main/assets/models/onnx-whisper/*.txt
app/src/main/assets/models/onnx-piper/**/*.onnx
app/src/main/assets/models/onnx-piper/**/*.txt
app/src/main/assets/models/onnx-piper/**/espeak-ng-data/
app/src/main/assets/models/**/*.bin
# Keep the directories
!app/src/main/assets/models/**/
!.gitkeep

# ── Model Cache (CI download cache) ──────────────────────────
.model-cache/

# ── Native Dependencies (cloned by setup_native_deps.sh) ────
app/src/main/cpp/third_party/llama.cpp/
app/src/main/cpp/third_party/sherpa-onnx/

# ── Native Cache ─────────────────────────────────────────────
.native-cache/

# ── OS ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Environment ───────────────────────────────────────────────
.env
.env.local

# ── APK (built artifacts) ────────────────────────────────────
*.apk

# ── Scripts temp ─────────────────────────────────────────────
scripts/*.tmp
